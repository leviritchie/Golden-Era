                                                                                                            "any positive status",
                                                                                                            "round start as cleanse proof",
                                                                                                            "regeneration inferred from law name"
                                                                                                        ],
                                                                               "notes":  "Rampart calendar lifecycle requires explicit cleanse/regeneration/resistance windows while status mutation remains separate."
                                                                           },
                      "stronghold.warcry-festival-calendar":  {
                                                                  "lifecycleKinds":  [
                                                                                         "adventure-day-astrology-progress",
                                                                                         "battle-start-warcry-festival-window",
                                                                                         "round-start-warcry-followup-window"
                                                                                     ],
                                                                  "companionPredicates":  [
