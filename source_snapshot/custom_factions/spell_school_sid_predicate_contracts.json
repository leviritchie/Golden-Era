                               ],
    "requiredRuntimeProof":  [
                                 "spell pool identity proof",
                                 "spell cooldown read/mutation ordering proof",
                                 "cast-gate and UI synchronization proof",
                                 "caster law-owner correlation proof when classification is used in runtime"
