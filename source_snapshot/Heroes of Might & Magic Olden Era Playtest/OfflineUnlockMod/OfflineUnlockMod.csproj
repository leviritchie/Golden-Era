     <Exec Command="python &quot;$(Homm3BundlePayloadDirectoryValidator)&quot; --bundle-dir &quot;$(PluginDeployDir)homm3_bundles&quot;" Condition="'$(Homm3BundleDeployModeActive)' == 'true' and '$(ValidateInstalledHomm3BundleDirNormalized)' == 'true'" Timeout="300000" />
