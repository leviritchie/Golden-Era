    <Delete Files="$(PluginDeployDir)homm3_runtime_assets\campaign_port\homecoming_water_traversal_plan.json" TreatErrorsAsWarnings="false" Condition="'$(DeployPluginBinaryOnlyNormalized)' != 'true'" />
    <Delete Files="$(PluginDeployDir)homm3_runtime_assets\campaign_port\homecoming_water_tile_overlay_identity_manifest.json" TreatErrorsAsWarnings="false" Condition="'$(DeployPluginBinaryOnlyNormalized)' != 'true'" />
    <Delete Files="$(PluginDeployDir)homm3_runtime_assets\custom_biomes\water\shore_sand.png" TreatErrorsAsWarnings="false" Condition="'$(DeployPluginBinaryOnlyNormalized)' != 'true'" />
    <Delete Files="$(PluginDeployDir)homm3_homecoming_playable_shell_launch.flag;$(PluginDeployDir)homm3_homecoming_quickstart_state_probe.flag;$(PluginDeployDir)homm3_homecoming_boat_travel_native_proof.flag;$(PluginDeployDir)homm3_selected_unit_hud_hotkey_probe.flag;$(PluginDeployDir)homm3_selected_hud_diag.flag" TreatErrorsAsWarnings="false" Condition="'$(DeployPluginBinaryOnlyNormalized)' != 'true'" />
    <Exec Condition="'$(FullValidationNormalized)' == 'true'" Command="python &quot;$(MSBuildThisFileDirectory)..\..\tools\validate_homecoming_native_water_runtime_contract.py&quot; --repo-root &quot;$(MSBuildThisFileDirectory)..\..&quot; --source-plugin-dir &quot;$(MSBuildThisFileDirectory).&quot; --plugin-dir &quot;$(PluginDeployDir).&quot;" Timeout="300000" />
    <!-- Retired lanes (single_layer, layered_atlas) no longer have installed-readback
         validators here. Installed-payload proof for the shipped raw_translation maps is
         owned by ValidateRoeCastleCampaignContinuityContract and
         ValidateMapLoadPreflightContract. -->
  </Target>
  <PropertyGroup>
    <RunExpensiveProceduralScenarioAudits Condition="'$(RunExpensiveProceduralScenarioAudits)' == ''">false</RunExpensiveProceduralScenarioAudits>
    <DeployProceduralScenarioBundle Condition="'$(DeployProceduralScenarioBundle)' == ''">false</DeployProceduralScenarioBundle>
    <ProceduralScenarioValidator>$(MSBuildThisFileDirectory)..\..\tools\validate_procedural_scenario_contract.py</ProceduralScenarioValidator>
    <ProceduralScenarioCli>$(MSBuildThisFileDirectory)..\..\tools\procedural_scenario_cli.py</ProceduralScenarioCli>
    <ProceduralScenarioAuditOutput Condition="'$(ProceduralScenarioAuditOutput)' == ''">$(MSBuildThisFileDirectory)..\..\build\procedural_audit</ProceduralScenarioAuditOutput>
  </PropertyGroup>
  <Target Name="ValidateProceduralScenarioContract" BeforeTargets="Build" Condition="'$(FullValidationNormalized)' == 'true'">
    <Error Text="Missing procedural scenario contract validator: $(ProceduralScenarioValidator)" Condition="!Exists('$(ProceduralScenarioValidator)')" />
    <Exec Command="python &quot;$(ProceduralScenarioValidator)&quot;" Timeout="300000" />
  </Target>
  <Target Name="ValidateHomm3AttachmentPipelineContract" BeforeTargets="BeforeBuild" Condition="'$(FullValidationNormalized)' == 'true'">
    <Exec Command="python &quot;$(MSBuildThisFileDirectory)..\..\tools\validate_homm3_attachment_pipeline_contract.py&quot;" Timeout="300000" />
  </Target>
  <Target Name="ValidateLiveProbeCompileContract" BeforeTargets="BeforeBuild" Condition="'$(FullValidationNormalized)' == 'true'">
    <PropertyGroup>
      <LiveProbeCompileContractValidator>$(MSBuildThisFileDirectory)..\..\tools\validate_live_probe_compile_contract.py</LiveProbeCompileContractValidator>
    </PropertyGroup>
    <Error Text="Missing live probe compile contract validator: $(LiveProbeCompileContractValidator)" Condition="!Exists('$(LiveProbeCompileContractValidator)')" />
    <Exec Command="python &quot;$(LiveProbeCompileContractValidator)&quot; --repo-root &quot;$(MSBuildThisFileDirectory)..\..&quot;" Timeout="60000" />
  </Target>
  <Target Name="ValidateHomm3AiHoverOwnerContract" BeforeTargets="BeforeBuild" Condition="'$(FullValidationNormalized)' == 'true'">
    <PropertyGroup>
      <Homm3AiHoverOwnerContractValidator>$(MSBuildThisFileDirectory)..\..\tools\validate_homm3_ai_hover_owner_contract.py</Homm3AiHoverOwnerContractValidator>
    </PropertyGroup>
    <Error Text="Missing AI hover owner contract validator: $(Homm3AiHoverOwnerContractValidator)" Condition="!Exists('$(Homm3AiHoverOwnerContractValidator)')" />
    <Exec Command="python &quot;$(Homm3AiHoverOwnerContractValidator)&quot; --repo-root &quot;$(MSBuildThisFileDirectory)..\..&quot;" Timeout="60000" />
  </Target>
  <Target Name="ValidateManagedModSettingsJsonRuntime" BeforeTargets="BeforeBuild;DeployPluginToGame" Condition="'$(FullValidationNormalized)' == 'true' or '$(DeployPluginToGame)' == 'true'">
    <Error Text="The selected game root must provide dotnet\System.Text.Json.dll at $(GameRootDir)dotnet\System.Text.Json.dll; the plugin uses the game-shared assembly and does not deploy a parser copy." Condition="!Exists('$(GameRootDir)dotnet\System.Text.Json.dll')" />
    <ItemGroup>
      <ManagedModSettingsJsonRuntimeAssembly Include="$(GameRootDir)dotnet\System.Text.Json.dll" />
    </ItemGroup>
    <GetAssemblyIdentity AssemblyFiles="@(ManagedModSettingsJsonRuntimeAssembly)">
      <Output TaskParameter="Assemblies" ItemName="ManagedModSettingsJsonRuntimeIdentity" />
    </GetAssemblyIdentity>
    <PropertyGroup>
      <ManagedModSettingsJsonRuntimeVersion>@(ManagedModSettingsJsonRuntimeIdentity-&gt;'%(Version)')</ManagedModSettingsJsonRuntimeVersion>
    </PropertyGroup>
    <Error Text="Could not read the game-shared System.Text.Json assembly identity from $(GameRootDir)dotnet\System.Text.Json.dll." Condition="'$(ManagedModSettingsJsonRuntimeVersion)' == ''" />
    <Error Text="The selected game root provides System.Text.Json $(ManagedModSettingsJsonRuntimeVersion); version 6 or newer is required." Condition="'$(ManagedModSettingsJsonRuntimeVersion)' != '' and $([System.Version]::Parse('$(ManagedModSettingsJsonRuntimeVersion)').Major) &lt; 6" />
  </Target>
  <Target Name="ValidateNativePreviewStartupContract" BeforeTargets="BeforeBuild" DependsOnTargets="ValidateManagedModSettingsJsonRuntime" Condition="'$(FullValidationNormalized)' == 'true'">
    <PropertyGroup>
      <NativePreviewStartupContractValidator>$(MSBuildThisFileDirectory)..\..\tools\validate_native_preview_startup_contract.py</NativePreviewStartupContractValidator>
    </PropertyGroup>
    <Error Text="Missing native preview startup contract validator: $(NativePreviewStartupContractValidator)" Condition="!Exists('$(NativePreviewStartupContractValidator)')" />
    <Exec Command="python &quot;$(NativePreviewStartupContractValidator)&quot; --repo-root &quot;$(MSBuildThisFileDirectory)..\..&quot;" Timeout="60000" />
  </Target>
  <Target Name="AuditProceduralScenarioGeneration" AfterTargets="Build" DependsOnTargets="ValidateProceduralScenarioContract" Condition="'$(RunExpensiveProceduralScenarioAudits)' == 'true'">
    <Error Text="Procedural scenario artifact audit requires an explicit /p:GameRoot pointing to the active Golden Era install." Condition="'$(GameRootExplicitlyProvided)' != 'true'" />
    <Exec Command="python &quot;$(ProceduralScenarioValidator)&quot; --expensive --core &quot;$(GameRootDir)HeroesOldenEra_Data\StreamingAssets\Core.zip&quot; --donor &quot;$(GameRootDir)HeroesOldenEra_Data\StreamingAssets\maps\Thirst_for_Power.map&quot; --output &quot;$(ProceduralScenarioAuditOutput)&quot;" Timeout="300000" />
  </Target>
  <Target Name="DeployProceduralScenario" AfterTargets="Build" DependsOnTargets="ValidateProceduralScenarioContract" Condition="'$(DeployProceduralScenarioBundle)' == 'true'">
    <Error Text="Procedural scenario deployment requires an explicit /p:GameRoot pointing to the active Golden Era install." Condition="'$(GameRootExplicitlyProvided)' != 'true'" />
    <Error Text="Procedural scenario deployment requires /p:ProceduralScenarioBundle pointing to a validated bundle." Condition="'$(ProceduralScenarioBundle)' == '' or !Exists('$(ProceduralScenarioBundle)\manifest.json')" />
    <Exec Command="python &quot;$(ProceduralScenarioCli)&quot; install &quot;$(ProceduralScenarioBundle)&quot; --game-root &quot;$(GameRoot)&quot;" />
  </Target>
</Project>
