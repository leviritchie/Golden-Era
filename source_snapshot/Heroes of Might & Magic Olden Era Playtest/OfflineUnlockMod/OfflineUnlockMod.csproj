<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GameRootExplicitlyProvided>false</GameRootExplicitlyProvided>
    <GameRootExplicitlyProvided Condition="'$(GameRoot)' != ''">true</GameRootExplicitlyProvided>
    <GameSymbolsHintContractBuild Condition="'$(GameSymbolsHintContractBuild)' == ''">current</GameSymbolsHintContractBuild>
    <DeployPluginBinaryOnly Condition="'$(DeployPluginBinaryOnly)' == ''">false</DeployPluginBinaryOnly>
    <DeployPluginBinaryOnlyNormalized>false</DeployPluginBinaryOnlyNormalized>
    <DeployPluginBinaryOnlyNormalized Condition="'$(DeployPluginBinaryOnly)' == 'true' or '$(DeployPluginBinaryOnly)' == 'True' or '$(DeployPluginBinaryOnly)' == 'TRUE'">true</DeployPluginBinaryOnlyNormalized>
    <GameRoot Condition="'$(GameRoot)' == ''">$(MSBuildThisFileDirectory)..\</GameRoot>
    <GameRootDir>$([MSBuild]::EnsureTrailingSlash('$(GameRoot)'))</GameRootDir>
    <BepInExRoot Condition="'$(BepInExRoot)' == ''">$(GameRootDir)BepInEx\</BepInExRoot>
    <BepInExRootDir>$([MSBuild]::EnsureTrailingSlash('$(BepInExRoot)'))</BepInExRootDir>
    <PluginDeployDir Condition="'$(PluginDeployDir)' == ''">$(BepInExRootDir)plugins\$(AssemblyName)\</PluginDeployDir>
    <PublishPluginDir>$([MSBuild]::EnsureTrailingSlash('$(MSBuildThisFileDirectory)publish_plugin'))</PublishPluginDir>
    <DeployHomm3LooseLabPngSidecars Condition="'$(DeployHomm3LooseLabPngSidecars)' == ''">false</DeployHomm3LooseLabPngSidecars>
    <DeployHomm3Bundles Condition="'$(DeployHomm3Bundles)' == ''">false</DeployHomm3Bundles>
    <DeployHomm3BundlesNormalized>false</DeployHomm3BundlesNormalized>
    <DeployHomm3BundlesNormalized Condition="'$(DeployHomm3Bundles)' == 'true' or '$(DeployHomm3Bundles)' == 'True' or '$(DeployHomm3Bundles)' == 'TRUE'">true</DeployHomm3BundlesNormalized>
    <DeployHomm3BundleNameNormalized>false</DeployHomm3BundleNameNormalized>
    <DeployHomm3BundleNameNormalized Condition="'$(DeployHomm3BundleName)' != ''">true</DeployHomm3BundleNameNormalized>
    <DeployHomm3FactoryBulwarkBundles Condition="'$(DeployHomm3FactoryBulwarkBundles)' == ''">false</DeployHomm3FactoryBulwarkBundles>
    <DeployHomm3FactoryBulwarkBundlesNormalized>false</DeployHomm3FactoryBulwarkBundlesNormalized>
    <DeployHomm3FactoryBulwarkBundlesNormalized Condition="'$(DeployHomm3FactoryBulwarkBundles)' == 'true' or '$(DeployHomm3FactoryBulwarkBundles)' == 'True' or '$(DeployHomm3FactoryBulwarkBundles)' == 'TRUE'">true</DeployHomm3FactoryBulwarkBundlesNormalized>
    <!-- Whole installed homm3_bundles readback after any HoMM3 bundle deploy mode (see DeployPluginToGame).
         Default false until the in-flight redeploys (stale bundles + pegasus line) land; then flip the default to true. -->
    <ValidateInstalledHomm3BundleDir Condition="'$(ValidateInstalledHomm3BundleDir)' == ''">true</ValidateInstalledHomm3BundleDir>
    <ValidateInstalledHomm3BundleDirNormalized>false</ValidateInstalledHomm3BundleDirNormalized>
    <ValidateInstalledHomm3BundleDirNormalized Condition="'$(ValidateInstalledHomm3BundleDir)' == 'true' or '$(ValidateInstalledHomm3BundleDir)' == 'True' or '$(ValidateInstalledHomm3BundleDir)' == 'TRUE'">true</ValidateInstalledHomm3BundleDirNormalized>
    <DeployHomm3ScenarioPayloads Condition="'$(DeployHomm3ScenarioPayloads)' == ''">false</DeployHomm3ScenarioPayloads>
    <DeployHomm3ScenarioPayloadsNormalized>false</DeployHomm3ScenarioPayloadsNormalized>
    <DeployHomm3ScenarioPayloadsNormalized Condition="'$(DeployHomm3ScenarioPayloads)' == 'true' or '$(DeployHomm3ScenarioPayloads)' == 'True' or '$(DeployHomm3ScenarioPayloads)' == 'TRUE'">true</DeployHomm3ScenarioPayloadsNormalized>
    <RunExpensiveArtifactAudits Condition="'$(RunExpensiveArtifactAudits)' == ''">false</RunExpensiveArtifactAudits>
    <RunExpensiveHomecomingArtifactAudits Condition="'$(RunExpensiveHomecomingArtifactAudits)' == ''">$(RunExpensiveArtifactAudits)</RunExpensiveHomecomingArtifactAudits>
    <HexInteropRootDir Condition="'$(HexInteropRootDir)' == ''">$(PublishPluginDir)</HexInteropRootDir>
    <UnityInteropRootDir Condition="'$(UnityInteropRootDir)' == ''">$(PublishPluginDir)</UnityInteropRootDir>
    <UnityWebRequestAudioModuleHintPath Condition="Exists('$(PublishPluginDir)UnityEngine.UnityWebRequestAudioModule.dll')">$(PublishPluginDir)UnityEngine.UnityWebRequestAudioModule.dll</UnityWebRequestAudioModuleHintPath>
    <UnityWebRequestAudioModuleHintPath Condition="'$(UnityWebRequestAudioModuleHintPath)' == '' and Exists('$(BepInExRootDir)interop\UnityEngine.UnityWebRequestAudioModule.dll')">$(BepInExRootDir)interop\UnityEngine.UnityWebRequestAudioModule.dll</UnityWebRequestAudioModuleHintPath>
    <!-- Validation tiers (docs/build_validation_tiers.md): test deploys run compile + deploy-safety gates only;
         -p:FullValidation=true (release / manual / contract-owning changes) runs every contract validator. -->
    <FullValidationNormalized>false</FullValidationNormalized>
    <FullValidationNormalized Condition="'$(FullValidation)' == 'true' or '$(FullValidation)' == 'True' or '$(FullValidation)' == 'TRUE' or '$(ReleaseCandidateBuild)' == 'true'">true</FullValidationNormalized>
    <OfficialDeobfBuildNormalized>false</OfficialDeobfBuildNormalized>
    <OfficialDeobfBuildNormalized Condition="'$(OfficialDeobfBuild)' == 'true' or '$(OfficialDeobfBuild)' == 'True' or '$(OfficialDeobfBuild)' == 'TRUE'">true</OfficialDeobfBuildNormalized>
  </PropertyGroup>
  <Target Name="ValidateDeployPluginBinaryOnlyOptions" BeforeTargets="BeforeBuild;DeployPluginToGame" Condition="'$(DeployPluginToGame)' == 'true' and '$(TargetExt)' == '.dll'">
    <Error Text="DeployPluginBinaryOnly must be true or false; received '$(DeployPluginBinaryOnly)'." Condition="'$(DeployPluginBinaryOnly)' != 'true' and '$(DeployPluginBinaryOnly)' != 'True' and '$(DeployPluginBinaryOnly)' != 'TRUE' and '$(DeployPluginBinaryOnly)' != 'false' and '$(DeployPluginBinaryOnly)' != 'False' and '$(DeployPluginBinaryOnly)' != 'FALSE'" />
    <Error Text="DeployPluginBinaryOnly cannot be combined with an opt-in HoMM3 bundle or scenario payload deploy." Condition="'$(DeployPluginBinaryOnlyNormalized)' == 'true' and ('$(DeployHomm3BundlesNormalized)' == 'true' or '$(DeployHomm3FactoryBulwarkBundlesNormalized)' == 'true' or '$(DeployHomm3BundleNameNormalized)' == 'true' or '$(DeployHomm3ScenarioPayloadsNormalized)' == 'true')" />
  </Target>
  <Target Name="ValidateDeployPluginBinaryOnlyContract" BeforeTargets="BeforeBuild" Condition="'$(FullValidationNormalized)' == 'true' or ('$(DeployPluginToGame)' == 'true' and '$(DeployPluginBinaryOnlyNormalized)' == 'true')">
    <Exec Command="python &quot;$(MSBuildThisFileDirectory)..\..\tools\validate_binary_only_plugin_deploy_contract.py&quot; --project &quot;$(MSBuildThisFileFullPath)&quot;" Timeout="30000" />
  </Target>
  <PropertyGroup Condition="'$(OfficialDeobfBuildNormalized)' == 'true'">
    <HexInteropRootDir>$(BepInExRootDir)interop\</HexInteropRootDir>
    <UnityInteropRootDir>$(PublishPluginDir)</UnityInteropRootDir>
    <DefineConstants>$(DefineConstants);OFFICIAL_DEOBF_BUILD</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(ReleaseCandidateBuild)' == 'true'">
    <DefineConstants>$(DefineConstants);RELEASE_CANDIDATE_BUILD</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(EnableSelectedUnitHudHotkeyProbe)' == 'true' and '$(ReleaseCandidateBuild)' != 'true'">
    <DefineConstants>$(DefineConstants);ENABLE_SELECTED_UNIT_HUD_HOTKEY_PROBE</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="Exists('$(BepInExRootDir)interop\UnityEngine.UnityWebRequestAudioModule.dll')">
    <DefineConstants>$(DefineConstants);HAS_UNITYWEBREQUEST_AUDIO_MODULE</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="System.Text.Json" Version="6.0.11" ExcludeAssets="runtime" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="0Harmony">
      <HintPath>$(BepInExRootDir)core\0Harmony.dll</HintPath>
    </Reference>
    <Reference Include="BepInEx.Core">
      <HintPath>$(BepInExRootDir)core\BepInEx.Core.dll</HintPath>
    </Reference>
    <Reference Include="BepInEx.Unity.IL2CPP">
      <HintPath>$(BepInExRootDir)core\BepInEx.Unity.IL2CPP.dll</HintPath>
    </Reference>
    <Reference Include="Il2CppInterop.Common">
      <HintPath>$(BepInExRootDir)core\Il2CppInterop.Common.dll</HintPath>
    </Reference>
    <Reference Include="Il2CppInterop.Runtime">
      <HintPath>$(BepInExRootDir)core\Il2CppInterop.Runtime.dll</HintPath>
    </Reference>
    <Reference Include="Hex">
      <HintPath>$(HexInteropRootDir)Hex.dll</HintPath>
    </Reference>
    <Reference Include="Hex.Shared">
      <HintPath>$(HexInteropRootDir)Hex.Shared.dll</HintPath>
    </Reference>
    <Reference Include="Hex.Sound.Runtime">
      <HintPath>$(HexInteropRootDir)Hex.Sound.Runtime.dll</HintPath>
    </Reference>
    <Reference Include="Il2Cppmscorlib">
      <HintPath>$(UnityInteropRootDir)Il2Cppmscorlib.dll</HintPath>
    </Reference>
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(UnityInteropRootDir)Newtonsoft.Json.dll</HintPath>
    </Reference>
    <Reference Include="SixLabors.ImageSharp">
      <HintPath>$(MSBuildThisFileDirectory)publish_plugin\SixLabors.ImageSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.Postprocessing.Runtime">
      <HintPath>$(UnityInteropRootDir)Unity.Postprocessing.Runtime.dll</HintPath>
    </Reference>
    <Reference Include="Unity.TextMeshPro">
      <HintPath>$(UnityInteropRootDir)Unity.TextMeshPro.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(UnityInteropRootDir)UnityEngine.CoreModule.dll</HintPath>
    </Reference>
    <!-- Screenshot capture is engine-owned; resolve the installed module but never deploy a private copy. -->
    <Reference Include="UnityEngine.ScreenCaptureModule">
      <HintPath>$(BepInExRootDir)interop\UnityEngine.ScreenCaptureModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Analytics host guard (NativeAnalyticsHostGuard.cs): game-owned interop assemblies, never deployed. -->
    <Reference Include="Il2CppSystem">
      <HintPath>$(BepInExRootDir)interop\Il2CppSystem.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Grpc.Net.Client">
      <HintPath>$(BepInExRootDir)interop\Grpc.Net.Client.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.ParticleSystemModule">
      <HintPath>$(UnityInteropRootDir)UnityEngine.ParticleSystemModule.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.PhysicsModule">
      <HintPath>$(UnityInteropRootDir)UnityEngine.PhysicsModule.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.JSONSerializeModule">
      <HintPath>$(UnityInteropRootDir)UnityEngine.JSONSerializeModule.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.AnimationModule">
      <HintPath>$(UnityInteropRootDir)UnityEngine.AnimationModule.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.AssetBundleModule">
      <HintPath>$(UnityInteropRootDir)UnityEngine.AssetBundleModule.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.AudioModule">
      <HintPath>$(UnityInteropRootDir)UnityEngine.AudioModule.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>$(UnityInteropRootDir)UnityEngine.UI.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.UIModule">
      <HintPath>$(UnityInteropRootDir)UnityEngine.UIModule.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(UnityInteropRootDir)UnityEngine.IMGUIModule.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(UnityInteropRootDir)UnityEngine.TextRenderingModule.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.ImageConversionModule">
      <HintPath>$(UnityInteropRootDir)UnityEngine.ImageConversionModule.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.UnityWebRequestModule">
      <HintPath>$(UnityInteropRootDir)UnityEngine.UnityWebRequestModule.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.UnityWebRequestTextureModule">
      <HintPath>$(UnityInteropRootDir)UnityEngine.UnityWebRequestTextureModule.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.UnityWebRequestAudioModule" Condition="Exists('$(UnityWebRequestAudioModuleHintPath)')">
      <HintPath>$(UnityWebRequestAudioModuleHintPath)</HintPath>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>$(UnityInteropRootDir)UnityEngine.InputLegacyModule.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.VideoModule">
      <HintPath>$(UnityInteropRootDir)UnityEngine.VideoModule.dll</HintPath>
    </Reference>
  </ItemGroup>
  <ItemGroup Condition="'$(OfficialDeobfBuildNormalized)' == 'true'">
    <None Remove="publish_plugin\Hex.dll" />
    <None Remove="publish_plugin\Hex.Shared.dll" />
    <None Remove="publish_plugin\Hex.Sound.Runtime.dll" />
    <Content Remove="publish_plugin\Hex.dll" />
    <Content Remove="publish_plugin\Hex.Shared.dll" />
    <Content Remove="publish_plugin\Hex.Sound.Runtime.dll" />
    <EmbeddedResource Remove="publish_plugin\Hex.dll" />
    <EmbeddedResource Remove="publish_plugin\Hex.Shared.dll" />
    <EmbeddedResource Remove="publish_plugin\Hex.Sound.Runtime.dll" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\tools\olden_ai_sim\OldenAiSim.csproj">
      <Private>true</Private>
    </ProjectReference>
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="_decompiled_shipped\**\*" />
    <Compile Remove="_decompiled_filtered\**\*" />
    <Compile Remove="_decompiled_release_hex\**\*" />
    <Compile Remove="tmp_decomp_*.cs" />
    <Compile Remove="tools\**\*" />
    <Compile Remove="Homm3LiveProbeWorkbench.cs" Condition="'$(ReleaseCandidateBuild)' == 'true'" />
    <Compile Remove="LiveProbeTownUiState.cs" Condition="'$(ReleaseCandidateBuild)' == 'true'" />
    <Compile Remove="Homm3AiDriverBridge.cs" Condition="'$(ReleaseCandidateBuild)' == 'true'" />
    <Compile Remove="Homm3AiDriverBridge.ScreenDump.cs" Condition="'$(ReleaseCandidateBuild)' == 'true'" />
    <Compile Remove="Homm3AiDriverBridge.AdventureCapture.cs" Condition="'$(ReleaseCandidateBuild)' == 'true'" />
    <Compile Remove="Homm3AiDriverBridge.Hover.cs" Condition="'$(ReleaseCandidateBuild)' == 'true'" />
    <Compile Remove="Homm3AiDriverBridge.Focus.cs" Condition="'$(ReleaseCandidateBuild)' == 'true'" />
    <Compile Remove="Homm3AiDriverBridge.Pilot.cs" Condition="'$(ReleaseCandidateBuild)' == 'true'" />
    <Compile Remove="Homm3AiDriverFogCache.cs" Condition="'$(ReleaseCandidateBuild)' == 'true'" />
    <Compile Remove="Homm3AdventureAiDecisionProbe.cs" Condition="'$(ReleaseCandidateBuild)' == 'true'" />
    <Compile Remove="Homm3AdventureAiWeightBridge.cs" Condition="'$(ReleaseCandidateBuild)' == 'true'" />
    <!-- Selected-unit hotkey probe: opt-in local diagnostics only (never ReleaseCandidate; default builds omit unless EnableSelectedUnitHudHotkeyProbe=true). -->
    <Compile Remove="Homm3SelectedUnitHudHotkeyProbe.cs" Condition="'$(ReleaseCandidateBuild)' == 'true' or '$(EnableSelectedUnitHudHotkeyProbe)' != 'true'" />
    <None Remove="publish_plugin\**\*" Condition="'$(UseLiveInteropOnly)' == 'true'" />
    <None Remove="tools\**\*" Condition="'$(UseLiveInteropOnly)' == 'true'" />
    <Content Remove="publish_plugin\**\*" Condition="'$(UseLiveInteropOnly)' == 'true'" />
    <Content Remove="tools\**\*" Condition="'$(UseLiveInteropOnly)' == 'true'" />
    <EmbeddedResource Remove="publish_plugin\**\*" Condition="'$(UseLiveInteropOnly)' == 'true'" />
    <EmbeddedResource Remove="tools\**\*" Condition="'$(UseLiveInteropOnly)' == 'true'" />
  </ItemGroup>
  <Target Name="ValidateHomecomingRecognizableMapContract" BeforeTargets="BeforeBuild" Condition="'$(RunExpensiveHomecomingArtifactAudits)' == 'true'">
    <PropertyGroup>
      <HomecomingRecognizableMapValidator>$(MSBuildThisFileDirectory)..\..\tools\validate_homecoming_recognizable_map_contract.py</HomecomingRecognizableMapValidator>
    </PropertyGroup>
    <Error Text="Missing Homecoming recognizable underground-slice map validator: $(HomecomingRecognizableMapValidator)" Condition="!Exists('$(HomecomingRecognizableMapValidator)')" />
    <Exec Command="python &quot;$(HomecomingRecognizableMapValidator)&quot; --repo-root &quot;$(MSBuildThisFileDirectory)..\..&quot;" Timeout="300000" />
  </Target>
  <Target Name="ValidateHomecomingEditorTerrainProbeContract" BeforeTargets="BeforeBuild" Condition="'$(RunExpensiveHomecomingArtifactAudits)' == 'true'">
    <PropertyGroup>
      <HomecomingEditorTerrainProbeValidator>$(MSBuildThisFileDirectory)..\..\tools\validate_homecoming_editor_terrain_probe_contract.py</HomecomingEditorTerrainProbeValidator>
    </PropertyGroup>
    <Error Text="Missing Homecoming editor terrain probe validator: $(HomecomingEditorTerrainProbeValidator)" Condition="!Exists('$(HomecomingEditorTerrainProbeValidator)')" />
    <Exec Command="python &quot;$(HomecomingEditorTerrainProbeValidator)&quot; --repo-root &quot;$(MSBuildThisFileDirectory)..\..&quot;" Timeout="300000" />
  </Target>
  <Target Name="ValidateHomecomingAuthenticSliceContract" BeforeTargets="BeforeBuild" Condition="'$(RunExpensiveHomecomingArtifactAudits)' == 'true'">
    <PropertyGroup>
      <HomecomingAuthenticSliceValidator>$(MSBuildThisFileDirectory)..\..\tools\validate_homecoming_authentic_slice_contract.py</HomecomingAuthenticSliceValidator>
    </PropertyGroup>
    <Error Text="Missing Homecoming authentic Terraneus-layer slice validator: $(HomecomingAuthenticSliceValidator)" Condition="!Exists('$(HomecomingAuthenticSliceValidator)')" />
    <Exec Command="python &quot;$(HomecomingAuthenticSliceValidator)&quot; --repo-root &quot;$(MSBuildThisFileDirectory)..\..&quot;" Timeout="300000" />
  </Target>
  <Target Name="ValidateHomecomingReducedSliceRuntimeContract" BeforeTargets="BeforeBuild" Condition="'$(FullValidationNormalized)' == 'true'">
    <PropertyGroup>
      <HomecomingReducedSliceRuntimeValidator>$(MSBuildThisFileDirectory)..\..\tools\validate_homecoming_reduced_slice_runtime_contract.py</HomecomingReducedSliceRuntimeValidator>
    </PropertyGroup>
    <Error Text="Missing Homecoming reduced-slice runtime contract validator: $(HomecomingReducedSliceRuntimeValidator)" Condition="!Exists('$(HomecomingReducedSliceRuntimeValidator)')" />
    <Exec Command="python &quot;$(HomecomingReducedSliceRuntimeValidator)&quot; --plugin-dir &quot;$(MSBuildThisFileDirectory).&quot;" Timeout="300000" />
  </Target>
  <Target Name="ValidateHomecomingMapEmissionProbeContract" BeforeTargets="BeforeBuild" Condition="'$(FullValidationNormalized)' == 'true'">
    <PropertyGroup>
      <HomecomingMapEmissionProbeValidator>$(MSBuildThisFileDirectory)..\..\tools\validate_homecoming_map_emission_probe_contract.py</HomecomingMapEmissionProbeValidator>
    </PropertyGroup>
    <Error Text="Missing Homecoming map-emission feasibility probe validator: $(HomecomingMapEmissionProbeValidator)" Condition="!Exists('$(HomecomingMapEmissionProbeValidator)')" />
    <Exec Command="python &quot;$(HomecomingMapEmissionProbeValidator)&quot; --plugin-dir &quot;$(MSBuildThisFileDirectory).&quot;" Timeout="300000" />
  </Target>
  <Target Name="ValidateHomecomingPlayableShellLaunchContract" BeforeTargets="BeforeBuild" Condition="'$(FullValidationNormalized)' == 'true'">
    <PropertyGroup>
      <HomecomingPlayableShellLaunchValidator>$(MSBuildThisFileDirectory)..\..\tools\validate_homecoming_playable_shell_launch_contract.py</HomecomingPlayableShellLaunchValidator>
    </PropertyGroup>
    <Error Text="Missing Homecoming playable-shell launch validator: $(HomecomingPlayableShellLaunchValidator)" Condition="!Exists('$(HomecomingPlayableShellLaunchValidator)')" />
    <Exec Command="python &quot;$(HomecomingPlayableShellLaunchValidator)&quot; --plugin-dir &quot;$(MSBuildThisFileDirectory).&quot;" Timeout="300000" />
  </Target>
  <!-- Default: source/weave continuity only. Installed Story_maps/Core SID readiness is opt-in via
       RequireInstalledRoeCastlePayload=true (passes require-installed to the validator). Prefer that over Skip flags. -->
  <Target Name="ValidateRoeCastleCampaignContinuityContract" BeforeTargets="BeforeBuild" Condition="'$(FullValidationNormalized)' == 'true' and ('$(SkipRoeCastleContinuityContract)' != 'true')">
    <PropertyGroup>
      <RoeCastleCampaignContinuityValidator>$(MSBuildThisFileDirectory)..\..\tools\validate_roe_castle_campaign_continuity_contract.py</RoeCastleCampaignContinuityValidator>
      <RoeCastleContinuityRequireInstalledArgs Condition="'$(RequireInstalledRoeCastlePayload)' == 'true'"> --require-installed</RoeCastleContinuityRequireInstalledArgs>
    </PropertyGroup>
    <Error Text="Missing RoE Castle campaign continuity validator: $(RoeCastleCampaignContinuityValidator)" Condition="!Exists('$(RoeCastleCampaignContinuityValidator)')" />
    <Exec Command="python &quot;$(RoeCastleCampaignContinuityValidator)&quot; --repo-root &quot;$(MSBuildThisFileDirectory)..\..&quot;$(RoeCastleContinuityRequireInstalledArgs)" Timeout="300000" />
  </Target>
  <Target Name="ValidateCampaignHeroLevelCapContract" BeforeTargets="BeforeBuild" Condition="'$(FullValidationNormalized)' == 'true' and ('$(SkipCampaignHeroLevelCapContract)' != 'true')">
    <PropertyGroup>
      <CampaignHeroLevelCapValidator>$(MSBuildThisFileDirectory)..\..\tools\validate_campaign_hero_level_cap_contract.py</CampaignHeroLevelCapValidator>
    </PropertyGroup>
    <Error Text="Missing campaign hero level-cap validator: $(CampaignHeroLevelCapValidator)" Condition="!Exists('$(CampaignHeroLevelCapValidator)')" />
    <Exec Command="python &quot;$(CampaignHeroLevelCapValidator)&quot; --repo-root &quot;$(MSBuildThisFileDirectory)..\..&quot;" Timeout="300000" />
  </Target>
  <Target Name="ValidateHomm3CampaignHeroesRosterSeparationContract" BeforeTargets="BeforeBuild" Condition="'$(FullValidationNormalized)' == 'true' and ('$(SkipHomm3CampaignHeroesRosterSeparationContract)' != 'true')">
    <PropertyGroup>
      <Homm3CampaignHeroesRosterSeparationValidator>$(MSBuildThisFileDirectory)..\..\tools\validate_homm3_campaign_heroes_roster_separation_contract.py</Homm3CampaignHeroesRosterSeparationValidator>
    </PropertyGroup>
    <Error Text="Missing HoMM3 campaignHeroes roster-separation validator: $(Homm3CampaignHeroesRosterSeparationValidator)" Condition="!Exists('$(Homm3CampaignHeroesRosterSeparationValidator)')" />
    <Exec Command="python &quot;$(Homm3CampaignHeroesRosterSeparationValidator)&quot;" Timeout="300000" />
  </Target>
  <Target Name="ValidateHomm3StoryHubMapBackgroundContract" BeforeTargets="BeforeBuild" Condition="'$(FullValidationNormalized)' == 'true' and ('$(SkipHomm3StoryHubMapBackgroundContract)' != 'true')">
    <PropertyGroup>
      <Homm3StoryHubMapBackgroundValidator>$(MSBuildThisFileDirectory)..\..\tools\validate_homm3_storyhub_map_background_contract.py</Homm3StoryHubMapBackgroundValidator>
    </PropertyGroup>
    <Error Text="Missing HoMM3 StoryHub map background validator: $(Homm3StoryHubMapBackgroundValidator)" Condition="!Exists('$(Homm3StoryHubMapBackgroundValidator)')" />
    <Exec Command="python &quot;$(Homm3StoryHubMapBackgroundValidator)&quot; --repo-root &quot;$(MSBuildThisFileDirectory)..\..&quot;" Timeout="300000" />
  </Target>
  <Target Name="ValidateHomm3UiScaleContract" BeforeTargets="BeforeBuild" Condition="'$(FullValidationNormalized)' == 'true' and ('$(SkipHomm3UiScaleContract)' != 'true')">
    <PropertyGroup>
      <Homm3UiScaleValidator>$(MSBuildThisFileDirectory)..\..\tools\validate_homm3_ui_scale_contract.py</Homm3UiScaleValidator>
    </PropertyGroup>
    <Error Text="Missing HoMM3 UI scale validator: $(Homm3UiScaleValidator)" Condition="!Exists('$(Homm3UiScaleValidator)')" />
    <Exec Command="python &quot;$(Homm3UiScaleValidator)&quot; --repo-root &quot;$(MSBuildThisFileDirectory)..\..&quot;" Timeout="300000" />
  </Target>
  <!-- HoMM3 map squad death (docs/homm3_map_squad_death_contract.md): source gate that owned-skinned map shells hand the
       native squad drawer the owned Animator (vanilla Die sets die/isDead on GetComponentInChildren<Animator>). The
       installed-bundle data half runs in the homm3_bundles readback. -->
  <Target Name="ValidateHomm3MapSquadDeathContract" BeforeTargets="BeforeBuild" Condition="'$(FullValidationNormalized)' == 'true' and ('$(SkipHomm3MapSquadDeathContract)' != 'true')">
    <PropertyGroup>
      <Homm3MapSquadDeathValidator>$(MSBuildThisFileDirectory)..\..\tools\validate_homm3_map_squad_death_contract.py</Homm3MapSquadDeathValidator>
    </PropertyGroup>
    <Error Text="Missing HoMM3 map squad death validator: $(Homm3MapSquadDeathValidator)" Condition="!Exists('$(Homm3MapSquadDeathValidator)')" />
    <Exec Command="python &quot;$(Homm3MapSquadDeathValidator)&quot;" Timeout="300000" />
  </Target>
  <Target Name="ValidateUnitMoveSpeedNormalizationContract" BeforeTargets="BeforeBuild" Condition="'$(FullValidationNormalized)' == 'true'">
    <PropertyGroup>
      <UnitMoveSpeedNormalizationValidator>$(MSBuildThisFileDirectory)..\..\tools\validate_unit_move_speed_normalization_contract.py</UnitMoveSpeedNormalizationValidator>
    </PropertyGroup>
    <Error Text="Missing unit move speed normalization validator: $(UnitMoveSpeedNormalizationValidator)" Condition="!Exists('$(UnitMoveSpeedNormalizationValidator)')" />
    <Exec Command="python &quot;$(UnitMoveSpeedNormalizationValidator)&quot; --repo-root &quot;$(MSBuildThisFileDirectory)..\..&quot;" Timeout="300000" />
  </Target>
  <!-- HoMM3 city building tree (docs/homm3_city_building_tree.md): every homm3_*_city and landon clone in the installed Core ships the canonical HoMM3 prevBuildings, a legal derived construction-tree layout and prerequisite-ordered buildOrders. -->
  <Target Name="ValidateHomm3CityBuildingTreeContract" BeforeTargets="BeforeBuild" Condition="'$(FullValidationNormalized)' == 'true' and ('$(SkipHomm3CityBuildingTreeContract)' != 'true')">
    <PropertyGroup><Homm3CityBuildingTreeValidator>$(MSBuildThisFileDirectory)..\..\tools\release_port\validate_homm3_city_building_tree_contract.py</Homm3CityBuildingTreeValidator></PropertyGroup>
    <Error Text="Missing HoMM3 city building tree validator: $(Homm3CityBuildingTreeValidator)" Condition="!Exists('$(Homm3CityBuildingTreeValidator)')" />
