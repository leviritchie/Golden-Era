        "sourceUnitSid": "",
        "sourceSlotKind": "",
        "sourceSlotIndex": 0,
        "abilityType": "Ability_type_attack_mod",
        "animationIndex": 1,
        "turnBehavior": "ends",
        "energyLevel": 0,
        "cooldown": 0,
        "rank": 1,
        "iconKey": "",
        "mechanicsDebt": ""
