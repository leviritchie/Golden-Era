<Project Sdk="Microsoft.NET.Sdk">
  <!-- Offline harness for Homm3CoveTreasurePlan (pure plan generator). Compiles the plugin's file as-is; no game
       or interop references. Run: dotnet run -c Release (optionally followed by exported map JSON paths).
       Export real maps with ../export_map_regions.py. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <BaseOutputPath>V:\olden_port_work\cove_treasure\plan_harness_build\bin\</BaseOutputPath>
    <BaseIntermediateOutputPath>V:\olden_port_work\cove_treasure\plan_harness_build\obj\</BaseIntermediateOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\..\Heroes of Might &amp; Magic Olden Era Playtest\OfflineUnlockMod\Homm3CoveTreasurePlan.cs" Link="Homm3CoveTreasurePlan.cs" />
    <Compile Include="Program.cs" />
  </ItemGroup>
</Project>
