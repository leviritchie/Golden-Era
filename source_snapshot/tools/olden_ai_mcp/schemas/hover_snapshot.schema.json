{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "olden-ai-driver://schemas/hover_snapshot.schema.json",
  "title": "Olden AI Driver Hover Snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "frame",
    "mode",
    "timestamp",
    "pointer",
    "hover",
    "gaps"
  ],
  "properties": {
    "schemaVersion": { "const": "ai-driver.v1.hover-snapshot" },
    "frame": { "type": "integer", "minimum": 0 },
    "mode": {
      "type": "string",
      "enum": ["main_menu", "adventure_map", "town", "battle", "loading", "unknown"]
    },
    "timestamp": { "type": "string", "format": "date-time" },
    "pointer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y"],
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" }
      }
    },
    "hover": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lane", "fingerprint"],
      "properties": {
        "lane": { "type": "string", "enum": ["ui", "map", "none"] },
        "fingerprint": { "type": "string" },
        "path": { "type": "string" },
        "label": { "type": "string" },
        "name": { "type": "string" },
        "node": { "type": "integer" },
        "sid": { "type": "string" }
      }
    },
    "gaps": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "message"],
        "properties": {
          "code": { "type": "string", "minLength": 1 },
          "message": { "type": "string", "minLength": 1 },
          "blocking": { "type": "boolean" }
        }
      }
    }
  }
}
